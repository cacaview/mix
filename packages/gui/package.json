{
  "name": "@mix/gui",
  "version": "0.1.0",
  "private": true,
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --x64"
  },
  "build": {
    "appId": "dev.mix.gateway",
    "productName": "Mix",
    "files": ["src/**"],
    "directories": { "output": "release" },
    "win": { "target": ["nsis"] },
    "nsis": { "oneClick": true, "perMachine": false }
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.0.0"
  }
}
